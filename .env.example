# 이 파일을 복사해 .env를 만들고 실제 값을 입력한다. (.env는 Git에 올리지 않는다)
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=library_app
DB_PASSWORD=change-me
DB_NAME=library_robot

# 관리자 토큰 (프론트엔드 로그인 방식이 정해지기 전 임시 인증). 형식: 관리자ID:토큰,관리자ID2:토큰2
# 토큰 생성: .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKENS=admin:change-me-to-a-long-random-token

# 위치 검증 임계값 [가정: AI 담당자와 협의 후 조정]. 생략하면 아래 기본값이 쓰인다.
# VERIFY_MIN_DETECTION=0.5
# VERIFY_MIN_OCR=0.6
# VERIFY_MIN_IDENTIFICATION=0.8
# VERIFY_MAX_REOBSERVATIONS=2
# AUTO_REOBSERVATION=true
# REOBSERVATION_RESULT_WAIT_SECONDS=300
# AUTO_RETRIEVAL_REQUEST=true

# 로봇 통신 기준 [가정: 로봇 담당자와 협의 후 조정]
# ROBOT_OFFLINE_AFTER_SECONDS=60
# TASK_WATCHDOG_INTERVAL_SECONDS=10

# 테스트 전용 DB 이름 (pytest가 사용, 개발 DB와 달라야 함). 생략하면 library_robot_test
# TEST_DB_NAME=library_robot_test
